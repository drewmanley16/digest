# Beehiiv API (Settings -> Integrations -> API). Required for the /resources
# email gate: without these the gate refuses to unlock rather than losing leads.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx

# Signs the unlock cookie. Any long random string: openssl rand -base64 32
# Changing it re-locks everyone who already unlocked.
RESOURCE_UNLOCK_SECRET=

# One per entry in `resources.items` in src/lib/site.ts, named by its `urlEnv`.
# These are the real file links and must never be committed.
RESOURCE_URL_SYSTEM_DESIGN=
RESOURCE_URL_TECH_OA=
